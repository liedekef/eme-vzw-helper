<?php
namespace EMEVzw;

defined( 'ABSPATH' ) || exit;

/**
 * EME VZW PDF Generator
 * Genereert officiële Belgische formulieren met TCPDF + exacte PNG-achtergronden.
 * 
 * Wijzigingen t.o.v. vorige versie:
 * - Formulier II: herhaalt Luik C automatisch per 5 wijzigingen
 * - Output: standaard 'I' (inline) i.p.v. 'S' om wit scherm te vermijden
 * - Debug: rooster wordt automatisch getoond wanneer $debug = true
 */
class PdfGenerator {

    private \TCPDF $pdf;
    private string $bg_dir;
    private bool   $debug;
    private int    $current_page = 0;

    public function __construct( bool $debug = false ) {
        $this->bg_dir = trailingslashit( EME_VZW_DIR ) . 'assets/templates/';
        $this->debug  = $debug;

        $this->load_tcpdf();
        $this->init_pdf_engine();
    }

    /* ======================================================================
     *  INIT & LOADERS
     * ====================================================================== */

    private function load_tcpdf(): void {
        if ( class_exists( '\TCPDF' ) ) return;

        $candidates = [
            EME_VZW_DIR . 'vendor/tecnickcom/tcpdf/tcpdf.php',
            WP_PLUGIN_DIR . '/eme-vzw-helper/vendor/tecnickcom/tcpdf/tcpdf.php',
        ];
        foreach ( $candidates as $path ) {
            if ( file_exists( $path ) ) {
                require_once $path;
                return;
            }
        }
        throw new \RuntimeException( 'TCPDF library not found. Run: composer require tecnickcom/tcpdf' );
    }

    private function init_pdf_engine(): void {
        $this->pdf = new \TCPDF( PDF_PAGE_ORIENTATION, PDF_UNIT, PDF_PAGE_FORMAT, true, 'UTF-8', false );
        $this->pdf->SetCreator( 'EME VZW Helper v' . EME_VZW_VERSION );
        $this->pdf->SetPrintHeader( false );
        $this->pdf->SetPrintFooter( false );
        $this->pdf->SetMargins( 0, 0, 0, true );
        $this->pdf->SetAutoPageBreak( false, 0 );
        $this->pdf->SetFont( 'helvetica', '', 9 );
        $this->pdf->SetTextColor( 0, 0, 0 );
    }

    /* ======================================================================
     *  PAGINA MANAGEMENT (FORMULIER I & II)
     * ====================================================================== */

    /**
     * Core: voeg een nieuwe A4-pagina toe met bijhorende achtergrond-PNG
     * Voegt automatisch kalibratierooster toe indien $this->debug = true
     */
    private function add_template_page( string $prefix, int $page_num ): self {
        $this->pdf->AddPage();
        $this->current_page = $page_num;

        $bg_file = sprintf( '%s%s_bg-%d.png', $this->bg_dir, $prefix, $page_num );
        $this->render_background( $bg_file );
        
        if ( $this->debug ) {
            $this->add_calibration_grid( 10 );
        }
        return $this;
    }

    private function render_background( string $file ): void {
        if ( file_exists( $file ) ) {
            $this->pdf->Image( $file, 0, 0, 210, 297, 'PNG', '', '', true, 300, '', false, false, 0, false, false, false );
        } elseif ( $this->debug ) {
            $this->pdf->SetXY( 10, 10 );
            $this->pdf->SetTextColor( 200, 0, 0 );
            $this->pdf->Write( 0, "⚠️ Achtergrond niet gevonden: " . basename( $file ) );
            $this->pdf->SetTextColor( 0, 0, 0 );
        }
    }

    // Formulier I
    public function add_luik_a(): self            { return $this->add_template_page( 'formulier1', 1 ); }
    public function add_luik_b(): self            { return $this->add_template_page( 'formulier1', 2 ); }
    public function add_luik_b_continuation(): self { return $this->add_template_page( 'formulier1', 3 ); }

    // Formulier II
    public function add_luik_a_f2(): self         { return $this->add_template_page( 'formulier2', 1 ); }
    public function add_luik_c_f2(): self         { return $this->add_template_page( 'formulier2', 2 ); }
    public function add_luik_c_f2_cont(): self    { return $this->add_template_page( 'formulier2', 3 ); } // Herhaalbaar

    /* ======================================================================
     *  VELD & CHECKBOX HELPERS
     * ====================================================================== */

    public function fill_field( float $x, float $y, string $text, float $width = 50, float $font_size = 10, string $align = 'L', bool $multiline = true ): self {
        $this->pdf->SetFont( 'helvetica', '', $font_size );
        $this->pdf->SetXY( $x, $y );
        
        if ( $multiline ) {
            $this->pdf->MultiCell( $width, 4, $text, 0, $align, false, 1, '', '', true, 0, true, true, 50, 'T' );
        } else {
            $this->pdf->Cell( $width, 5, $text, 0, 0, $align, false, '', 0, false, 'T', 'M' );
        }
        return $this;
    }

    public function fill_checkbox( float $x, float $y, bool $checked = false, float $size = 4 ): self {
        $this->pdf->SetDrawColor( 0, 0, 0 );
        $this->pdf->SetLineWidth( 0.2 );
        $this->pdf->Rect( $x, $y, $size, $size, 'D' );
        if ( $checked ) {
            $this->pdf->SetLineWidth( 0.3 );
            $this->pdf->Line( $x + 0.5, $y + 0.5, $x + $size - 0.5, $y + $size - 0.5 );
            $this->pdf->Line( $x + 0.5, $y + $size - 0.5, $x + $size - 0.5, $y + 0.5 );
        }
        return $this;
    }

    public function add_calibration_grid( int $step_mm = 10 ): self {
        $this->pdf->SetDrawColor( 255, 0, 0 );
        $this->pdf->SetLineWidth( 0.1 );
        $this->pdf->SetFont( 'helvetica', '', 6 );
        $this->pdf->SetTextColor( 255, 0, 0 );

        for ( $x = $step_mm; $x < 210; $x += $step_mm ) {
            $this->pdf->Line( $x, 0, $x, 297 );
            $this->pdf->SetXY( $x + 0.5, 1 );
            $this->pdf->Write( 0, $x );
        }
        for ( $y = $step_mm; $y < 297; $y += $step_mm ) {
            $this->pdf->Line( 0, $y, 210, $y );
            $this->pdf->SetXY( 1, $y + 0.5 );
            $this->pdf->Write( 0, $y );
        }
        $this->pdf->SetDrawColor( 0, 0, 0 );
        $this->pdf->SetTextColor( 0, 0, 0 );
        $this->pdf->SetLineWidth( 0.2 );
        return $this;
    }

    /* ======================================================================
     *  OUTPUT
     * ====================================================================== */

    /**
     * Output PDF. 
     * Gebruik standaard 'I' (inline) voor browser preview + Ctrl+P.
     * 'D' forceren voor directe download.
     */
    public function output( string $filename, string $dest = 'I' ): string|bool {
        // TCPDF stuurt zelf de juiste headers voor 'I' en 'D'
        return $this->pdf->Output( sanitize_file_name( $filename ), $dest );
    }

    /* ======================================================================
     *  STATIC GENERATORS
     * ====================================================================== */

    public static function generate_form1( int $pub_id, string $dest = 'I', bool $debug = false ): string|bool {
        $pub     = Publications::get( $pub_id );
        $config  = Config::get();
        $changes = Publications::get_board_changes( $pub_id );
        if ( ! $pub || ! $config ) throw new \RuntimeException( 'Publicatie of config niet gevonden.' );

        $gen = new self( $debug );

        // ── PAGINA 1: LUIK A ──
        $gen->add_luik_a();
        $gen->fill_field( 100, 78, $config->vzw_number ?? '', 40 );
        $gen->fill_field( 80, 84, $config->vzw_name ?? '', 80 );
        $gen->fill_field( 90, 99, $config->vzw_legal_form ?? 'VZW', 30 );
        $gen->fill_field( 80, 109, $config->street ?? '', 60 );
        $gen->fill_field( 150, 109, $config->house_number ?? '', 60 );
        $gen->fill_field( 175, 109, $config->house_bus ?? '', 60 );
        $gen->fill_field( 85, 114, $config->postal_code ?? '', 30 );
        $gen->fill_field( 135, 114, $config->city ?? '', 60 );
        $gen->fill_field( 80, 120, $config->country ?? '', 60 );

        // ── PAGINA 2: LUIK B (START) ──
        $gen->add_luik_b();
        $gen->fill_field( 80, 64, $config->vzw_number ?? '', 40 );
        $gen->fill_field( 80, 72, $config->vzw_name ?? '', 80 );
        $gen->fill_field( 80, 76, $config->vzw_shortname ?? '', 80 );
        $gen->fill_field( 80, 82, $config->vzw_legal_form ?? 'VZW', 30 );
        $address = ($config->street ?? '') . ' ' . ($config->house_number ?? '') . ' bus ' . ($config->house_bus ?? '')
            .', '. ($config->postal_code ?? '') . ' ' . ($config->city ?? '');
        $gen->fill_field( 80, 87, $address , 80 );
        //$gen->fill_field( 15, 95, ! empty( $pub->av_date ) ? date_i18n( 'd/m/Y', strtotime( $pub->av_date ) ) : '', 30 );

        $subjects = [];
        if ( array_filter( $changes, fn($c) => $c->change_type === 'B' ) ) $subjects[] = 'BENOEMING(EN)';
        if ( array_filter( $changes, fn($c) => $c->change_type === 'E' ) ) $subjects[] = 'ONTSLAG(NEMINGEN)';
        if ( $pub->type === 'statute_change' ) $subjects[] = __( 'WIJZIGING(EN) STATUTEN', 'eme-vzw-helper' );
        $gen->fill_field( 70, 97, implode( ' *** ', $subjects ), 125 );

        $lines = [];
        foreach ( $changes as $c ) {
            $type = match($c->change_type) { 'B' => 'Benoemd', 'E' => 'Ontslag', default => '' };
            if ( $type ) {
                $lines[] = sprintf( '%s: %s %s, %s, %s', $type, $c->last_name, $c->first_name, $c->role, trim( $c->street . ' ' . $c->house_number . ', ' . $c->postal_code . ' ' . $c->city ) );
            }
        }
        $text = implode( "\n", $lines );

        // Simpele overflow-check: > 12 regels → pagina 3 toevoegen
        $lines_count = substr_count( $text, "\n" ) + 1;
        if ( $lines_count > 12 ) {
            $part1 = array_slice( $lines, 0, 12 );
            $part2 = array_slice( $lines, 12 );
            $gen->fill_field( 15, 115, implode( "\n", $part1 ), 180, 10, 'L', true );
            $gen->add_luik_b_continuation();
            $gen->fill_field( 15, 115, implode( "\n", $part2 ), 180, 10, 'L', true );
        } else {
            $gen->fill_field( 15, 115, $text, 180, 10, 'L', true );
        }

        // ── HANDTEKENINGEN ──
        $gen->fill_field( 150, 270, date_i18n( 'd/m/Y' ), 20, 10, 'R' );
        $gen->fill_field( 180, 270, $config->city ?? '', 20, 10, 'R' );

        return $gen->output( 'Formulier_I.pdf', $dest );
    }

    public static function generate_form2( int $pub_id, string $dest = 'I', bool $debug = false ): string|bool {
        $pub     = Publications::get( $pub_id );
        $config  = Config::get();
        $changes = Publications::get_board_changes( $pub_id );
        if ( ! $pub || ! $config ) throw new \RuntimeException( 'Publicatie of config niet gevonden.' );

        // Filter alleen B (benoeming) en E (ontslag) voor Formulier II
        $board_changes = array_filter( $changes, fn($c) => in_array( $c->change_type, ['B', 'E'], true ) );
        $gen = new self( $debug );

        // ── PAGINA 1: LUIK A ──
        $gen->add_luik_a_f2();
        $gen->fill_field( 55, 35, $config->vzw_number ?? '', 40 );
        $gen->fill_field( 55, 41, $config->vzw_name ?? '', 80 );
        $gen->fill_field( 55, 47, $config->vzw_legal_form ?? 'VZW', 30 );
        $gen->fill_field( 55, 53, trim( ( $config->street ?? '' ) . ' ' . ( $config->house_number ?? '' ) ), 60 );
        $gen->fill_field( 55, 59, trim( ( $config->postal_code ?? '' ) . ' ' . ( $config->city ?? '' ) ), 40 );

        // ── PAGINA 2 & HERVERVAL: LUIK C (Max 5 per blad) ──
        $chunks = array_chunk( $board_changes, 5 );
        foreach ( $chunks as $idx => $chunk ) {
            // Eerste chunk op pagina 2, volgende chunks op herhaalpagina 3
            $idx === 0 ? $gen->add_luik_c_f2() : $gen->add_luik_c_f2_cont();
            
            $y_start = 100; // Start Y positie eerste rij Luik C (moet gekalibreerd worden)
            $y_step  = 7;   // Hoogte per rij in mm
            
            foreach ( $chunk as $i => $c ) {
                $y = $y_start + ( $i * $y_step );
                $type_char = $c->change_type === 'B' ? 'B' : 'E';
                
                $gen->fill_field( 10, $y, $type_char, 8, 10, 'C' );
                $gen->fill_field( 20, $y, $c->national_id ?? '', 25, 8 );
                $gen->fill_field( 47, $y, trim( $c->last_name . ' ' . $c->first_name ), 60, 8 );
                $gen->fill_field( 110, $y, $c->role ?? 'Bestuurder', 40, 8 );
                $gen->fill_field( 155, $y, ! empty( $pub->av_date ) ? date_i18n( 'd/m/Y', strtotime( $pub->av_date ) ) : '', 25, 8, 'C' );
            }
        }

        // ── HANDTEKENING (op laatste pagina) ──
        $gen->fill_field( 150, 270, date_i18n( 'd/m/Y' ), 20, 8, 'R' );
        $gen->fill_field( 180, 270, $config->city ?? '', 20, 8, 'R' );

        return $gen->output( 'Formulier_II.pdf', $dest );
    }
}
