<?php
namespace EMEVzw;

defined( 'ABSPATH' ) || exit;

/**
 * Wettelijke publicaties:
 *  - Formulier I (luik A + B) : publicatie Belgisch Staatsblad
 *  - Formulier II (luik A + C): KBO-update
 *  - Statutenwijziging: volledig document voor griffie
 *
 * PDF generation uses fpdf2 (bundled) or falls back to HTML-print.
 * The layout reproduces the official Belgian government forms exactly
 * as required by the griffie (KB 29 april 2019).
 */
class Publications {

    public static function init(): void {
        add_action( 'wp_ajax_eme_vzw_save_publication',       [ __CLASS__, 'ajax_save' ] );
        add_action( 'wp_ajax_eme_vzw_generate_form1',         [ __CLASS__, 'ajax_generate_form1' ] );
        add_action( 'wp_ajax_eme_vzw_generate_form2',         [ __CLASS__, 'ajax_generate_form2' ] );
        add_action( 'wp_ajax_eme_vzw_generate_statute_change',[ __CLASS__, 'ajax_generate_statute_change' ] );
        add_action( 'wp_ajax_eme_vzw_generate_extract',       [ __CLASS__, 'ajax_generate_extract' ] );
        add_action( 'wp_ajax_eme_vzw_delete_publication',     [ __CLASS__, 'ajax_delete' ] );
        // Serve generated PDFs
        add_action( 'wp_ajax_eme_vzw_download_pdf',           [ __CLASS__, 'ajax_download_pdf' ] );
    }

    /* ------------------------------------------------------------------
     * DATA CRUD
     * ------------------------------------------------------------------ */

    public static function get_all( int $config_id = 1 ): array {
        global $wpdb;
        return $wpdb->get_results( $wpdb->prepare(
            "SELECT * FROM `{$wpdb->prefix}emevzw_publications`
             WHERE config_id = %d ORDER BY av_date DESC",
            $config_id
        ) );
    }

    public static function get( int $id ): ?object {
        global $wpdb;
        return $wpdb->get_row( $wpdb->prepare(
            "SELECT * FROM `{$wpdb->prefix}emevzw_publications` WHERE id = %d",
            $id
        ) );
    }

    public static function get_board_changes( int $pub_id ): array {
        global $wpdb;
        return $wpdb->get_results( $wpdb->prepare(
            "SELECT pb.*, b.first_name, b.last_name, b.national_id, b.birth_place, b.birth_date,
                    b.street, b.house_number, b.house_bus, b.postal_code, b.city, b.country,
                    b.role, b.is_legal_entity, b.legal_name, b.legal_number, b.legal_representative
             FROM `{$wpdb->prefix}emevzw_pub_board` pb
             JOIN  `{$wpdb->prefix}emevzw_board` b ON b.id = pb.board_id
             WHERE pb.publication_id = %d
             ORDER BY pb.change_type, b.last_name",
            $pub_id
        ) );
    }

    public static function get_statute_changes( int $pub_id ): array {
        global $wpdb;
        return $wpdb->get_results( $wpdb->prepare(
            "SELECT * FROM `{$wpdb->prefix}emevzw_statute_changes`
             WHERE publication_id = %d ORDER BY sort_order",
            $pub_id
        ) );
    }

    public static function save( array $data ): int|\WP_Error {
        global $wpdb;
        $allowed_statuses = [ 'draft', 'submitted', 'published' ];

        $row = [
            'config_id'         => (int) ( $data['config_id'] ?? 1 ),
            'av_date'           => eme_sanitize_request( $data['av_date'] ?? '' ),
            'av_location'       => eme_sanitize_request( $data['av_location'] ?? '' ),
            'statute_text'      => eme_sanitize_request( $data['statute_text'] ?? '' ),
            'submitted_date'    => ! empty( $data['submitted_date'] ) ? eme_sanitize_request( $data['submitted_date'] ) : null,
            'published_date'    => ! empty( $data['published_date'] ) ? eme_sanitize_request( $data['published_date'] ) : null,
            'bs_payment_ref'    => eme_sanitize_request( $data['bs_payment_ref'] ?? '' ),
            'bs_payment_date'   => ! empty( $data['bs_payment_date'] ) ? eme_sanitize_request( $data['bs_payment_date'] ) : null,
            'bs_payment_amount' => (float) ( $data['bs_payment_amount'] ?? 0 ),
            'status'            => in_array( $data['status'] ?? 'draft', $allowed_statuses, true ) ? $data['status'] : 'draft',
            'notes'             => eme_sanitize_request( $data['notes'] ?? '' ),
            'created_by'        => get_current_user_id(),
        ];

        $id = isset( $data['id'] ) ? (int) $data['id'] : 0;
        if ( $id > 0 ) {
            unset( $row['created_by'] );
            $wpdb->update( $wpdb->prefix . 'emevzw_publications', $row, [ 'id' => $id ], null, [ '%d' ] );
        } else {
            $wpdb->insert( $wpdb->prefix . 'emevzw_publications', $row );
            $id = (int) $wpdb->insert_id;
        }

        // Board changes (onveranderd)
        if ( isset( $data['board_changes'] ) && is_array( $data['board_changes'] ) ) {
            $wpdb->delete( $wpdb->prefix . 'emevzw_pub_board', [ 'publication_id' => $id ], [ '%d' ] );
            foreach ( $data['board_changes'] as $bc ) {
                $wpdb->insert( $wpdb->prefix . 'emevzw_pub_board', [
                    'publication_id' => $id,
                    'board_id'       => (int) $bc['board_id'],
                    'change_type'    => in_array( $bc['change_type'] ?? 'B', [ 'B', 'E', 'H' ], true ) ? $bc['change_type'] : 'B',
                    'effective_date' => ! empty( $bc['effective_date'] ) ? eme_sanitize_request( $bc['effective_date'] ) : null,
                ] );
            }
        }
        return $id;
    }

    /* ------------------------------------------------------------------
     * PDF GENERATION – FORMULIER I
     *
     * Formulier I: publicatie in het Belgisch Staatsblad
     *   Luik A: identificatie rechtspersoon
     *   Luik B: uittreksel akte (bestuurswijziging)
     *   Achterkant luik B: handtekeningen
     *
     * The official form layout is reproduced using HTML/CSS that can be
     * printed to PDF via the browser, OR via the PHP HTML-to-PDF
     * converter. The layout exactly mirrors the official FOD Justitie form.
     * ------------------------------------------------------------------ */

    /**
     * Generate Formulier I HTML (ready for PDF print / browser print).
     */
    public static function generate_form1_html( int $pub_id ): string {
        $pub          = self::get( $pub_id );
        $board_changes= self::get_board_changes( $pub_id );
        $config       = Config::get();
        if ( ! $pub || ! $config ) return '';

        $benoemingen = array_filter( $board_changes, fn($b) => $b->change_type === 'B' );
        $ontslagen   = array_filter( $board_changes, fn($b) => $b->change_type === 'E' );

        // Build luik B subject text
        $subjects = [];
        if ( $benoemingen ) $subjects[] = __( 'BENOEMING(EN)', 'eme-vzw-helper' );
        if ( $ontslagen )   $subjects[] = __( 'ONTSLAG(NEMINGEN)', 'eme-vzw-helper' );
        if ( $pub->type === 'statute_change' ) $subjects[] = __( 'WIJZIGING(EN) STATUTEN', 'eme-vzw-helper' );
        $subject_text = implode( ' *** ', $subjects );

        ob_start();
        include EME_VZW_DIR . 'templates/pdf/formulier1.php';
        return ob_get_clean();
    }

    /**
     * Generate Formulier II HTML (KBO-update form).
     */
    public static function generate_form2_html( int $pub_id ): string {
        $pub          = self::get( $pub_id );
        $board_changes= self::get_board_changes( $pub_id );
        $config       = Config::get();
        if ( ! $pub || ! $config ) return '';

        ob_start();
        include EME_VZW_DIR . 'templates/pdf/formulier2.php';
        return ob_get_clean();
    }

    /**
     * Generate the AV extract (uittreksel notulen) text.
     */
    public static function generate_extract_html( int $pub_id ): string {
        $pub          = self::get( $pub_id );
        $board_changes= self::get_board_changes( $pub_id );
        $config       = Config::get();
        if ( ! $pub || ! $config ) return '';

        ob_start();
        include EME_VZW_DIR . 'templates/pdf/extract.php';
        return ob_get_clean();
    }

    /**
     * Generate statute change document HTML.
     */
    public static function generate_statute_change_html( int $pub_id ): string {
        $pub            = self::get( $pub_id );
        $statute_changes= self::get_statute_changes( $pub_id );
        $config         = Config::get();
        if ( ! $pub || ! $config ) return '';

        ob_start();
        include EME_VZW_DIR . 'templates/pdf/statute_change.php';
        return ob_get_clean();
    }

    /* ------------------------------------------------------------------
     * AJAX
     * ------------------------------------------------------------------ */

    public static function ajax_save(): void {
        check_ajax_referer( 'eme_vzw_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_options' ) ) wp_send_json_error();
        $data = json_decode( file_get_contents( 'php://input' ), true ) ?? $_POST;
        $r    = self::save( $data );
        is_wp_error( $r ) ? wp_send_json_error( $r->get_error_message() ) : wp_send_json_success( [ 'id' => $r ] );
    }

    public static function ajax_generate_form1(): void {
        check_ajax_referer( 'eme_vzw_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_options' ) ) wp_send_json_error();
        $html = self::generate_form1_html( (int) ( $_POST['pub_id'] ?? 0 ) );
        wp_send_json_success( [ 'html' => $html ] );
    }

    public static function ajax_generate_form2(): void {
        check_ajax_referer( 'eme_vzw_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_options' ) ) wp_send_json_success( [
            'html' => self::generate_form2_html( (int) ( $_POST['pub_id'] ?? 0 ) )
        ] );
    }

    public static function ajax_generate_statute_change(): void {
        check_ajax_referer( 'eme_vzw_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_options' ) ) wp_send_json_error();
        wp_send_json_success( [
            'html' => self::generate_statute_change_html( (int) ( $_POST['pub_id'] ?? 0 ) )
        ] );
    }

    public static function ajax_generate_extract(): void {
        check_ajax_referer( 'eme_vzw_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_options' ) ) wp_send_json_error();
        wp_send_json_success( [
            'html' => self::generate_extract_html( (int) ( $_POST['pub_id'] ?? 0 ) )
        ] );
    }

    public static function ajax_delete(): void {
        check_ajax_referer( 'eme_vzw_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_options' ) ) wp_send_json_error();
        global $wpdb;
        $id = (int) ( $_POST['id'] ?? 0 );
        $wpdb->delete( $wpdb->prefix . 'emevzw_pub_board',        [ 'publication_id' => $id ], [ '%d' ] );
        $wpdb->delete( $wpdb->prefix . 'emevzw_statute_changes',  [ 'publication_id' => $id ], [ '%d' ] );
        $wpdb->delete( $wpdb->prefix . 'emevzw_publications',     [ 'id' => $id ], [ '%d' ] );
        wp_send_json_success();
    }

    /**
     * Generate and stream a PDF using EME's bundled dompdf.
     */
        /**
     * Generate and stream a PDF.
     * Prioriteert TCPDF voor officiële formulieren, valt terug op dompdf voor uittreksels.
     */
    public static function ajax_download_pdf(): void {
        if ( ! wp_verify_nonce( $_GET['nonce'] ?? '', 'eme_vzw_nonce' ) ) {
            wp_die( esc_html__( 'Ongeldige beveiligingstoken.', 'eme-vzw-helper' ), 403 );
        }
        if ( ! current_user_can( 'manage_options' ) ) {
            wp_die( esc_html__( 'Onvoldoende rechten.', 'eme-vzw-helper' ), 403 );
        }

        $type   = sanitize_key( $_GET['doc_type'] ?? 'form1' );
        $pub_id = (int) ( $_GET['pub_id'] ?? 0 );
        $debug  = isset( $_GET['debug'] );

        if ( $pub_id <= 0 ) {
            wp_die( esc_html__( 'Ongeldige publicatie-ID.', 'eme-vzw-helper' ), 400 );
        }

        // ✅ Nieuw: Gebruik TCPDF voor officiële formulieren
        if ( in_array( $type, [ 'form1', 'form2' ], true ) ) {
            try {
                $method = $type === 'form1' ? 'generate_form1' : 'generate_form2';
                PdfGenerator::$method( $pub_id, 'I', $debug );
                exit;
            } catch ( \Throwable $e ) {
                if ( defined( 'WP_DEBUG' ) && WP_DEBUG ) {
                    error_log( 'EME VZW PDF Error: ' . $e->getMessage() );
                }
                wp_die( esc_html__( 'Fout bij genereren formulier: ' . $e->getMessage(), 'eme-vzw-helper' ) );
            }
        }

        // old dompdf, still used for extract
        $html = match ( $type ) {
            'form2'          => self::generate_form2_html( $pub_id ),
            'extract'        => self::generate_extract_html( $pub_id ),
            'statute_change' => self::generate_statute_change_html( $pub_id ),
            default          => self::generate_form1_html( $pub_id ),
        };

        if ( empty( $html ) ) {
            wp_die( esc_html__( 'Document kon niet worden gegenereerd. Controleer of de publicatie bestaat en correct is opgeslagen.', 'eme-vzw-helper' ), 404 );
        }

        $doc_names = [
            'form1'          => 'Formulier_I',
            'form2'          => 'Formulier_II',
            'extract'        => 'Uittreksel_notulen',
            'statute_change' => 'Statutenwijziging',
        ];
        $filename = ( $doc_names[ $type ] ?? 'document' ) . '_' . $pub_id . '.pdf';

        // Locate dompdf via EME (events-made-easy)
        $dompdf_autoload = WP_PLUGIN_DIR . '/events-made-easy/includes/dompdf/vendor/autoload.php';
        if ( ! file_exists( $dompdf_autoload ) ) {
            wp_die( esc_html__( 'dompdf niet gevonden. Controleer of Events Made Easy correct geïnstalleerd is.', 'eme-vzw-helper' ) );
        }

        require_once $dompdf_autoload;

        $options = new \Dompdf\Options();
        $options->set( 'isHtml5ParserEnabled', true );
        $options->set( 'isRemoteEnabled', false );
        $options->set( 'defaultFont', 'helvetica' );

        $dompdf = new \Dompdf\Dompdf( $options );

        $full_html = '<!DOCTYPE html><html lang="nl"><head><meta charset="UTF-8">'
            . '<style>body{font-family:Helvetica,Arial,sans-serif;font-size:10pt;line-height:1.4;color:#000}'
            . 'table{border-collapse:collapse;width:100%} td,th{padding:3px 6px;vertical-align:top}'
            . '</style></head><body>'
            . $html
            . '</body></html>';

        $dompdf->loadHtml( $full_html );
        $dompdf->setPaper( 'A4', 'portrait' );
        $dompdf->render();

        // Stream PDF inline (opens in browser, saveable as PDF)
        $dompdf->stream( $filename, [ 'Attachment' => false ] );
        exit;
    }
}
