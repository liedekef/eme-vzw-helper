<?php
namespace EMEVzw;
defined( 'ABSPATH' ) || exit;

/* ===========================================================================
 * VZW Configuration
 * =========================================================================== */
class Config {

    public static function init(): void {
        add_action( 'wp_ajax_eme_vzw_save_config',        [ __CLASS__, 'ajax_save' ] );
        add_action( 'wp_ajax_eme_vzw_save_board_member',  [ __CLASS__, 'ajax_save_board' ] );
        add_action( 'wp_ajax_eme_vzw_delete_board_member',[ __CLASS__, 'ajax_delete_board' ] );
    }

    public static function get( int $id = 1 ): ?object {
        global $wpdb;
        return $wpdb->get_row( $wpdb->prepare(
            "SELECT * FROM `{$wpdb->prefix}eme_vzw_config` WHERE id = %d",
            $id
        ) );
    }

    public static function get_active_board_members( int $config_id = 1 ): array {
        global $wpdb;
        return $wpdb->get_results( $wpdb->prepare(
            "SELECT * FROM `{$wpdb->prefix}eme_vzw_board`
             WHERE config_id = %d AND is_active = 1
             ORDER BY last_name",
            $config_id
        ) );
    }

    public static function get_board_member( int $id ): ?object {
        global $wpdb;
        return $wpdb->get_row( $wpdb->prepare(
            "SELECT * FROM `{$wpdb->prefix}eme_vzw_board` WHERE id = %d",
            $id
        ) );
    }

    public static function save( array $data ): int|\WP_Error {
        global $wpdb;
        $row = [
            'vzw_name'             => eme_sanitize_request( $data['vzw_name'] ?? '' ),
            'vzw_number'           => eme_sanitize_request( $data['vzw_number'] ?? '' ),
            'vzw_legal_form'       => eme_sanitize_request( $data['vzw_legal_form'] ?? 'VZW' ),
            'street'               => eme_sanitize_request( $data['street'] ?? '' ),
            'house_number'         => eme_sanitize_request( $data['house_number'] ?? '' ),
            'house_bus'            => eme_sanitize_request( $data['house_bus'] ?? '' ),
            'postal_code'          => eme_sanitize_request( $data['postal_code'] ?? '' ),
            'city'                 => eme_sanitize_request( $data['city'] ?? '' ),
            'country'              => eme_sanitize_request( $data['country'] ?? 'België' ),
            'court'                => eme_sanitize_request( $data['court'] ?? '' ),
            'fiscal_year_start_mm' => max( 1, min( 12, (int) ( $data['fiscal_year_start_mm'] ?? 1 ) ) ),
            'fiscal_year_start_dd' => max( 1, min( 31, (int) ( $data['fiscal_year_start_dd'] ?? 1 ) ) ),
            'fiscal_year_end_mm'   => max( 1, min( 12, (int) ( $data['fiscal_year_end_mm'] ?? 12 ) ) ),
            'fiscal_year_end_dd'   => max( 1, min( 31, (int) ( $data['fiscal_year_end_dd'] ?? 31 ) ) ),
            'current_fiscal_year'  => (int) ( $data['current_fiscal_year'] ?? gmdate( 'Y' ) ),
            'vat_liable'           => (int) (bool) ( $data['vat_liable'] ?? 0 ),
            'is_micro_vzw'         => (int) (bool) ( $data['is_micro_vzw'] ?? 1 ),
            'ubo_last_confirmed'   => ! empty( $data['ubo_last_confirmed'] ) ? eme_sanitize_request( $data['ubo_last_confirmed'] ) : null,
            'ubo_next_deadline'    => ! empty( $data['ubo_next_deadline'] ) ? eme_sanitize_request( $data['ubo_next_deadline'] ) : null,
            'statutes_last_published'=> ! empty( $data['statutes_last_published'] ) ? eme_sanitize_request( $data['statutes_last_published'] ) : null,
            'board_mandate_end'    => ! empty( $data['board_mandate_end'] ) ? eme_sanitize_request( $data['board_mandate_end'] ) : null,
            'notification_email'   => sanitize_email( $data['notification_email'] ?? '' ),
        ];

        $id = isset( $data['id'] ) ? (int) $data['id'] : 1;
        $exists = (int) $wpdb->get_var( $wpdb->prepare(
            "SELECT COUNT(*) FROM `{$wpdb->prefix}eme_vzw_config` WHERE id = %d", $id
        ) );

        if ( $exists ) {
            $wpdb->update( $wpdb->prefix . 'eme_vzw_config', $row, [ 'id' => $id ], null, [ '%d' ] );
        } else {
            $wpdb->insert( $wpdb->prefix . 'eme_vzw_config', $row );
            $id = (int) $wpdb->insert_id;
        }
        return $id;
    }

    public static function save_board_member( array $data ): int|\WP_Error {
        global $wpdb;
        $row = [
            'config_id'            => (int) ( $data['config_id'] ?? 1 ),
            'first_name'           => eme_sanitize_request( $data['first_name'] ?? '' ),
            'last_name'            => eme_sanitize_request( $data['last_name'] ?? '' ),
            'national_id'          => eme_sanitize_request( $data['national_id'] ?? '' ),
            'street'               => eme_sanitize_request( $data['street'] ?? '' ),
            'house_number'         => eme_sanitize_request( $data['house_number'] ?? '' ),
            'house_bus'            => eme_sanitize_request( $data['house_bus'] ?? '' ),
            'postal_code'          => eme_sanitize_request( $data['postal_code'] ?? '' ),
            'city'                 => eme_sanitize_request( $data['city'] ?? '' ),
            'country'              => eme_sanitize_request( $data['country'] ?? 'België' ),
            'role'                 => eme_sanitize_request( $data['role'] ?? 'bestuurder' ),
            'email'                => sanitize_email( $data['email'] ?? '' ),
            'phone'                => eme_sanitize_request( $data['phone'] ?? '' ),
            'appointed_date'       => ! empty( $data['appointed_date'] ) ? eme_sanitize_request( $data['appointed_date'] ) : null,
            'appointment_av_date'  => ! empty( $data['appointment_av_date'] ) ? eme_sanitize_request( $data['appointment_av_date'] ) : null,
            'end_date'             => ! empty( $data['end_date'] ) ? eme_sanitize_request( $data['end_date'] ) : null,
            'mandate_duration'     => (int) ( $data['mandate_duration'] ?? 0 ),
            'no_management_ban'    => (int) (bool) ( $data['no_management_ban'] ?? 0 ),
            'is_active'            => (int) (bool) ( $data['is_active'] ?? 1 ),
            'is_legal_entity'      => (int) (bool) ( $data['is_legal_entity'] ?? 0 ),
            'legal_name'           => eme_sanitize_request( $data['legal_name'] ?? '' ),
            'legal_number'         => eme_sanitize_request( $data['legal_number'] ?? '' ),
            'legal_representative' => eme_sanitize_request( $data['legal_representative'] ?? '' ),
            'notes'                => eme_sanitize_request( $data['notes'] ?? '' ),
        ];
        $id = isset( $data['id'] ) ? (int) $data['id'] : 0;
        if ( $id > 0 ) {
            $wpdb->update( $wpdb->prefix . 'eme_vzw_board', $row, [ 'id' => $id ], null, [ '%d' ] );
            return $id;
        }
        $wpdb->insert( $wpdb->prefix . 'eme_vzw_board', $row );
        return (int) $wpdb->insert_id;
    }

    public static function ajax_save(): void {
        check_ajax_referer( 'eme_vzw_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_options' ) ) wp_send_json_error();
        $r = self::save( $_POST );
        is_wp_error( $r ) ? wp_send_json_error( $r->get_error_message() ) : wp_send_json_success( [ 'id' => $r ] );
    }

    public static function ajax_save_board(): void {
        check_ajax_referer( 'eme_vzw_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_options' ) ) wp_send_json_error();
        $r = self::save_board_member( $_POST );
        is_wp_error( $r ) ? wp_send_json_error( $r->get_error_message() ) : wp_send_json_success( [ 'id' => $r ] );
    }

    public static function ajax_delete_board(): void {
        check_ajax_referer( 'eme_vzw_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_options' ) ) wp_send_json_error();
        global $wpdb;
        // Soft delete
        $wpdb->update( $wpdb->prefix . 'eme_vzw_board', [ 'is_active' => 0 ], [ 'id' => (int) ( $_POST['id'] ?? 0 ) ] );
        wp_send_json_success();
    }
}

/* ===========================================================================
 * Notifications & Reminders via WP Cron
 * =========================================================================== */
class Notifications {

    public static function init(): void {
        add_action( 'eme_vzw_daily_check', [ __CLASS__, 'run_checks' ] );
        if ( ! wp_next_scheduled( 'eme_vzw_daily_check' ) ) {
            wp_schedule_event( time(), 'daily', 'eme_vzw_daily_check' );
        }
    }

    public static function run_checks(): void {
        $config = Config::get();
        if ( ! $config || ! $config->notification_email ) return;

        $today    = new \DateTime( current_time( 'Y-m-d' ) );
        $warnings = [];

        // Board mandate end warning (30 days)
        if ( $config->board_mandate_end ) {
            $end  = new \DateTime( $config->board_mandate_end );
            $diff = $today->diff( $end );
            if ( $end >= $today && $diff->days <= 30 ) {
                $warnings[] = sprintf(
                    __( 'Bestuursmandaat loopt af op %s (nog %d dagen).', 'eme-vzw-helper' ),
                    date_i18n( 'd/m/Y', strtotime( $config->board_mandate_end ) ),
                    $diff->days
                );
            }
        }

        // UBO annual confirmation (warn if > 11 months ago)
        if ( $config->ubo_last_confirmed ) {
            $last = new \DateTime( $config->ubo_last_confirmed );
            $diff = $last->diff( $today );
            if ( $diff->days >= 335 ) {
                $warnings[] = __( 'UBO-register: jaarlijkse bevestiging vereist. Laatste bevestiging was meer dan 11 maanden geleden.', 'eme-vzw-helper' );
            }
        }

        // Patrimonium tax (30 March reminder)
        $march31 = new \DateTime( $today->format( 'Y' ) . '-03-31' );
        if ( $today <= $march31 ) {
            $diff = $today->diff( $march31 );
            if ( $diff->days <= 14 ) {
                $warnings[] = __( 'Aangifte Patrimoniumtaks: deadline is 31 maart.', 'eme-vzw-helper' );
            }
        }

        if ( empty( $warnings ) ) return;

        wp_mail(
            $config->notification_email,
            sprintf( __( '[%s] VZW Compliance – Actie vereist', 'eme-vzw-helper' ), $config->vzw_name ),
            implode( "\n\n", $warnings ) . "\n\n" . admin_url( 'admin.php?page=eme-vzw-helper' )
        );
    }
}

/* ===========================================================================
 * Admin assets
 * =========================================================================== */
class Assets {
    public static function init(): void {
        add_action( 'admin_enqueue_scripts', [ __CLASS__, 'enqueue' ] );
    }

    public static function enqueue( string $hook ): void {
        if ( strpos( $hook, 'eme-vzw' ) === false ) return;
        wp_enqueue_style( 'eme-vzw', EME_VZW_URL . 'assets/css/admin.css', [], EME_VZW_VERSION );
        wp_enqueue_script( 'eme-vzw', EME_VZW_URL . 'assets/js/admin.js', [ 'jquery' ], EME_VZW_VERSION, true );
        wp_localize_script( 'eme-vzw', 'emeVzw', [
            'nonce'   => wp_create_nonce( 'eme_vzw_nonce' ),
            'ajaxUrl' => admin_url( 'admin-ajax.php' ),
            'i18n'    => [
                'confirm_delete' => __( 'Zeker verwijderen?', 'eme-vzw-helper' ),
                'saving'         => __( 'Opslaan…', 'eme-vzw-helper' ),
                'saved'          => __( 'Opgeslagen', 'eme-vzw-helper' ),
                'print_form'     => __( 'Afdrukken als PDF', 'eme-vzw-helper' ),
            ],
        ] );
    }
}

/* ===========================================================================
 * Admin Menu
 * =========================================================================== */
namespace EMEVzw\Admin;
defined( 'ABSPATH' ) || exit;

class Menu {
    public static function init(): void {
        add_action( 'admin_menu', [ __CLASS__, 'register' ] );
    }

    public static function register(): void {
        add_menu_page(
            __( 'EME VZW Helper', 'eme-vzw-helper' ),
            __( 'EME VZW Helper', 'eme-vzw-helper' ),
            'manage_options',
            'eme-vzw-helper',
            [ __CLASS__, 'page_dashboard' ],
            'dashicons-groups',
            57
        );

        foreach ( [
            [ 'eme-vzw-helper',              __( 'Dashboard', 'eme-vzw-helper' ),          'page_dashboard' ],
            [ 'eme-vzw-helper-checklist',    __( 'Compliance Checklist', 'eme-vzw-helper' ),'page_checklist' ],
            [ 'eme-vzw-helper-publications', __( 'Publicaties', 'eme-vzw-helper' ),         'page_publications' ],
            [ 'eme-vzw-helper-board',        __( 'Bestuur', 'eme-vzw-helper' ),             'page_board' ],
            [ 'eme-vzw-helper-config',       __( 'Instellingen VZW', 'eme-vzw-helper' ),    'page_config' ],
        ] as [ $slug, $title, $method ] ) {
            add_submenu_page( 'eme-vzw-helper', $title, $title, 'manage_options', $slug, [ __CLASS__, $method ] );
        }
    }

    private static function tpl( string $name, array $vars = [] ): void {
        extract( $vars, EXTR_SKIP ); // phpcs:ignore
        $f = EME_VZW_DIR . 'templates/' . $name . '.php';
        file_exists( $f ) ? include $f : print "<div class='wrap'><p>Template {$name} niet gevonden.</p></div>";
    }

    public static function page_dashboard():   void { self::tpl( 'dashboard' ); }
    public static function page_checklist():   void { self::tpl( 'checklist' ); }
    public static function page_publications():void { self::tpl( 'publications' ); }
    public static function page_board():       void { self::tpl( 'board' ); }
    public static function page_config():      void { self::tpl( 'config' ); }
}
