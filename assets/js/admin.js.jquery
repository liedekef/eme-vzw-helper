/* eme-vzw-helper/assets/js/admin.js */
/* global emeVzw, jQuery */
(function ($) {
    'use strict';

    const { nonce, ajaxUrl, i18n } = emeVzw;

    /* ── Generic AJAX ────────────────────────────────────────────── */
    function ajax(action, data, onSuccess, onError) {
        // Als data een string is, maak er een object van
        if (typeof data === 'string') {
            var params = new URLSearchParams(data);
            data = {};
            for (let [key, value] of params) {
                data[key] = value;
            }
        }
        return $.post(ajaxUrl, Object.assign({ action, nonce }, data))
            .done(r => {
                if (r.success) { onSuccess && onSuccess(r.data); }
                else { (onError || alert)(r.data || 'Fout'); }
            })
            .fail(() => (onError || alert)('Verbindingsfout'));
    }

    /* ════════════════════════════════════════════════════════════════
     * CHECKLIST
     * ════════════════════════════════════════════════════════════════ */

    // Status button click → save via AJAX, update UI score
    $(document).on('click', '.vzw-status-btn', function () {
        const $btn     = $(this);
        const $item    = $btn.closest('.vzw-check-item');
        const checkKey = $item.data('key');
        const status   = $btn.data('status');
        const year     = $('#vzw-fiscal-year').val() || new Date().getFullYear();
        const note     = $item.find('.vzw-check-note-input').val() || '';
        const subs     = collectSubAnswers( $item );

        // Optimistic UI update
        $item.removeClass( 'status-yes status-no status-na status-pending' )
             .addClass(`status-${status}`);
        $item.find('.vzw-status-btn').removeClass(
            'active-yes active-no active-na active-pending'
        );
        $btn.addClass(`active-${status}`);

        ajax('eme_vzw_save_check', {
            fiscal_year:  year,
            config_id:    1,
            check_key:    checkKey,
            status:       status,
            sub_answers:  JSON.stringify( subs ),
            notes:        note,
        }, function (data) {
            if (data && data.score) updateScoreUI(data.score);
        });
    });

    // Collect sub-question answers from a check-item
    function collectSubAnswers( $item ) {
        const subs = {};
        $item.find('.vzw-sub-input').each(function () {
            const $el  = $(this);
            const idx  = $el.data('subidx');
            if ( $el.attr('type') === 'radio' ) {
                if ( $el.is(':checked') ) subs[ idx ] = $el.val();
            } else {
                subs[ idx ] = $el.val();
            }
        });
        return subs;
    }

    // Note input change → auto-save after 800ms debounce
    let noteTimer;
    $(document).on('input change', '.vzw-check-note-input, .vzw-sub-input', function () {
        clearTimeout(noteTimer);
        const $item    = $(this).closest('.vzw-check-item');
        const checkKey = $item.data('key');
        const status   = $item.find('.vzw-status-btn.active-yes, .vzw-status-btn.active-no, .vzw-status-btn.active-na, .vzw-status-btn.active-pending').data('status') || 'pending';
        const year     = $('#vzw-fiscal-year').val() || new Date().getFullYear();

        noteTimer = setTimeout(() => {
            const note = $item.find('.vzw-check-note-input').val();
            const subs = collectSubAnswers( $item );
            ajax('eme_vzw_save_check', {
                fiscal_year:  year,
                config_id:    1,
                check_key:    checkKey,
                status:       status,
                sub_answers:  JSON.stringify( subs ),
                notes:        note,
            });
        }, 800);
    });

    function updateScoreUI(score) {
        // Ring
        const pct    = score.score_pct;
        const radius = 48;
        const circ   = 2 * Math.PI * radius;
        const offset = circ * (1 - pct / 100);
        const $circle = $('#score-ring-progress');
        if ($circle.length) {
            $circle.attr('stroke-dashoffset', offset.toFixed(1));
            $circle.attr('stroke', pct >= 80 ? '#00a32a' : pct >= 50 ? '#dba617' : '#d63638');
        }
        $('#score-pct-text').text(pct.toFixed(1) + '%');

        // Group scores
        const g = score.by_group;
        if (g.general) {
            const gPct = g.general.max > 0 ? (g.general.earned / g.general.max * 100).toFixed(1) : 0;
            $('#group-general-score').text(gPct + '%');
        }
        if (g.current_year) {
            const yPct = g.current_year.max > 0 ? (g.current_year.earned / g.current_year.max * 100).toFixed(1) : 0;
            $('#group-year-score').text(yPct + '%');
        }
    }

    // Year selector
    $(document).on('change', '#vzw-fiscal-year', function () {
        window.location = `${window.location.pathname}?page=eme-vzw-helper-checklist&year=${this.value}`;
    });

    /* ════════════════════════════════════════════════════════════════
     * PUBLICATIONS
     * ════════════════════════════════════════════════════════════════ */

    // Save publication form
    $(document).on('submit', '#vzw-pub-form', function (e) {
        e.preventDefault();
        const $form = $(this);
        const $btn  = $form.find('.submit-btn');
        $btn.text(i18n.saving).prop('disabled', true);

        const data = buildPublicationData($form);
        ajax('eme_vzw_save_publication', data, function (r) {
            $btn.text(i18n.saved).prop('disabled', false);
            if (!$form.find('[name="pub_id"]').val()) {
                // New publication — update hidden field and show document buttons
                $form.find('[name="pub_id"]').val(r.id);
                $('#vzw-doc-buttons').data('pub-id', r.id).show();
            }
            setTimeout(() => $btn.text('Opslaan').prop('disabled', false), 1800);
        }, msg => {
            $btn.text('Opslaan').prop('disabled', false);
            alert(msg);
        });
    });

    function buildPublicationData($form) {
        const data = {
            id:                  $form.find('[name="pub_id"]').val() || 0,
            config_id:           1,
            type:                $form.find('[name="pub_type"]').val(),
            av_date:             $form.find('[name="av_date"]').val(),
            submitted_date:      $form.find('[name="submitted_date"]').val(),
            published_date:      $form.find('[name="published_date"]').val(),
            bs_payment_ref:      $form.find('[name="bs_payment_ref"]').val(),
            bs_payment_date:     $form.find('[name="bs_payment_date"]').val(),
            bs_payment_amount:   $form.find('[name="bs_payment_amount"]').val(),
            status:              $form.find('[name="pub_status"]').val(),
            notes:               $form.find('[name="notes"]').val(),
            board_changes:       collectBoardChanges(),
            statute_changes:     collectStatuteChanges(),
        };
        return data;
    }

    function collectBoardChanges() {
        const changes = [];
        $('.vzw-board-change-row').each(function () {
            const bid  = $(this).find('.bc-board-id').val();
            const type = $(this).find('.bc-change-type').val();
            const date = $(this).find('.bc-effective-date').val();
            if (bid) changes.push({ board_id: bid, change_type: type, effective_date: date });
        });
        return changes;
    }

    function collectStatuteChanges() {
        const changes = [];
        $('.vzw-statute-change-row').each(function () {
            changes.push({
                article_number: $(this).find('.sc-article-number').val(),
                article_title:  $(this).find('.sc-article-title').val(),
                old_text:       $(this).find('.sc-old-text').val(),
                new_text:       $(this).find('.sc-new-text').val(),
                change_reason:  $(this).find('.sc-change-reason').val(),
            });
        });
        return changes;
    }

    // Add board change row
    $(document).on('click', '#btn-add-board-change', function () {
        const $tmpl = $('#vzw-board-change-template').clone().removeAttr('id').show();
        $('#vzw-board-changes-list').append($tmpl);
    });

    // Add statute change row
    $(document).on('click', '#btn-add-statute-change', function () {
        const $tmpl = $('#vzw-statute-change-template').clone().removeAttr('id').show();
        $('#vzw-statute-changes-list').append($tmpl);
    });

    // Remove row
    $(document).on('click', '.vzw-remove-row', function () {
        $(this).closest('.vzw-board-change-row, .vzw-statute-change-row').remove();
    });

    // Toggle statute change section visibility
    $(document).on('change', '[name="pub_type"]', function () {
        $('#vzw-statute-section').toggle( this.value === 'statute_change' );
    });

    // Generate & open document in new window (print to PDF)
    $(document).on('click', '.vzw-gen-doc', function () {
        const docType = $(this).data('doc-type');
        const pubId   = $(this).closest('[data-pub-id]').data('pub-id') || $('[name="pub_id"]').val();
        if (!pubId) { alert('Sla de publicatie eerst op.'); return; }
        const url = `${ajaxUrl}?action=eme_vzw_download_pdf&nonce=${nonce}&doc_type=${docType}&pub_id=${pubId}`;
        window.open(url, '_blank');
    });

    // Delete publication
    $(document).on('click', '.vzw-delete-pub', function () {
        if (!confirm(i18n.confirm_delete)) return;
        const $row = $(this).closest('tr');
        ajax('eme_vzw_delete_publication', { id: $(this).data('id') }, function () {
            $row.fadeOut(300, () => $row.remove());
        });
    });

    /* ════════════════════════════════════════════════════════════════
     * BOARD / CONFIG FORMS
     * ════════════════════════════════════════════════════════════════ */

    $(document).on('submit', '#vzw-board-form', function (e) {
        e.preventDefault();
        const $btn = $(this).find('.submit-btn');
        $btn.text(i18n.saving).prop('disabled', true);
        ajax('eme_vzw_save_board_member', $(this).serialize(), () => location.reload(), msg => {
            $btn.text('Opslaan').prop('disabled', false);
            alert(msg);
        });
    });

    $(document).on('click', '.vzw-delete-board', function () {
        if (!confirm(i18n.confirm_delete)) return;
        const $card = $(this).closest('.vzw-board-card');
        ajax('eme_vzw_delete_board_member', { id: $(this).data('id') }, () => {
            $card.fadeOut(300, () => $card.remove());
        });
    });

    $(document).on('submit', '#vzw-config-form', function (e) {
        e.preventDefault();
        const $btn = $(this).find('.submit-btn');
        $btn.text(i18n.saving).prop('disabled', true);
        ajax('eme_vzw_save_config', $(this).serialize(), function () {
            $btn.text(i18n.saved).prop('disabled', false);
            setTimeout(() => $btn.text('Opslaan').prop('disabled', false), 1800);
        });
    });

    // Legal entity toggle
    $(document).on('change', '#is_legal_entity', function () {
        $('#legal-entity-fields').toggle(this.checked);
        $('#natural-person-fields').toggle(!this.checked);
    });

}(jQuery));
